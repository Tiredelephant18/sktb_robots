[Unit]
Description=video_sender_from_rpi
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/student/rtc_robotics/video_utility
ExecStart=/home/student/venv_rtc_student/bin/python rpi_sender.py

Restart=always
RestartSec=3
User=student
Group=student

[Install]
WantedBy=multi-user.target
