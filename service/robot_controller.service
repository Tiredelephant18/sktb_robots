[Unit]
Description=video_sender_from_rpi
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/student/rtc_robotics/robot_ws
ExecStart=/home/student/venv_rtc_student/bin/python onboard.py

Restart=always
